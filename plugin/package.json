{
  "name": "valdroid-emulator",
  "displayName": "Valdroid Emulator",
  "icon": "media/icon.png",
  "description": "Android emulator and logcat inside VS Code.",
  "version": "0.1.5",
  "publisher": "Vali-98",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vali-98/valdroid-emulator.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/Vali-98/valdroid-emulator",
  "bugs": {
    "url": "https://github.com/Vali-98/valdroid-emulator/issues"
  },
  "extensionKind": [
    "ui"
  ],
  "keywords": [
    "android",
    "emulator",
    "adb",
    "logcat"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:valdroidConsole.view",
    "onCommand:valdroid-emulator.console",
    "onView:valdroidEmulator.view",
    "onCommand:valdroid-emulator.start",
    "onCommand:valdroid-emulator.stop",
    "onCommand:valdroid-emulator.settings",
    "onCommand:valdroid-emulator.show"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "valdroid-emulator.settings",
        "title": "Valdroid: Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "valdroid-emulator.show",
        "title": "Valdroid: Show Emulator"
      },
      {
        "command": "valdroid-emulator.start",
        "title": "Valdroid: Start Emulator"
      },
      {
        "command": "valdroid-emulator.stop",
        "title": "Valdroid: Stop Stream"
      },
      {
        "command": "valdroid-emulator.console",
        "title": "Valdroid: Show ADB Console",
        "icon": "$(terminal)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "valdroid-emulator.console",
          "when": "view == valdroidEmulator.view",
          "group": "navigation@1"
        },
        {
          "command": "valdroid-emulator.settings",
          "when": "view == valdroidEmulator.view",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "valdroidConsole",
          "title": "Valdroid",
          "icon": "media/android.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "valdroidEmulator",
          "title": "Valdroid Emulator",
          "icon": "media/android.svg"
        }
      ]
    },
    "views": {
      "valdroidConsole": [
        {
          "id": "valdroidConsole.view",
          "name": "ADB Console",
          "type": "webview"
        }
      ],
      "valdroidEmulator": [
        {
          "id": "valdroidEmulator.view",
          "name": "Valdroid Emulator",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Valdroid Emulator",
      "properties": {
        "valdroid-emulator.sdkPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "order": 1,
          "description": "Android SDK folder containing platform-tools and emulator. Leave empty to discover it from ANDROID_HOME, ANDROID_SDK_ROOT, or the usual installation folder. Reload the window after changing this setting."
        },
        "valdroid-emulator.adbPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "order": 2,
          "description": "Optional path to the adb executable (adb.exe on Windows). Overrides the SDK folder. Leave empty to use SDK discovery, then PATH. Reload the window after changing this setting."
        },
        "valdroid-emulator.emulatorPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "order": 3,
          "description": "Optional path to the emulator executable (emulator.exe on Windows). Overrides the SDK folder. Leave empty to use SDK discovery, then PATH. Reload the window after changing this setting."
        },
        "valdroid-emulator.bitRate": {
          "type": "integer",
          "default": 10000000,
          "minimum": 100000,
          "maximum": 100000000,
          "order": 4,
          "description": "AVC video bitrate in bits per second. Reload the window after changing this setting."
        }
      }
    }
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "build": "npm run check-types && npm run lint && node esbuild.js",
    "vsix": "node scripts/package-vsix.cjs",
    "release": "node scripts/release.cjs",
    "test:packaging": "node --test scripts/*.test.cjs",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "npm run check-types && tsc --noEmit -p tests/tsconfig.json && vitest run",
    "test:watch": "vitest",
    "profile": "node scripts/profile.cjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "24.x",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/shell-quote": "^1.7.5",
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "patch-package": "^8.0.1",
    "playwright": "1.64.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.19",
    "file-selector": "^2.1.2",
    "lucide-react": "^1.57.0",
    "opus-decoder": "^0.7.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^14.3.8",
    "react-scan": "0.1.3",
    "shell-quote": "^1.12.0"
  }
}
