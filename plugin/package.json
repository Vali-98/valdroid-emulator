{
  "name": "valdroid-emulator",
  "displayName": "Valdroid Emulator",
  "description": "Android emulator streaming, device controls, file transfers, and an ADB/logcat console inside VS Code.",
  "version": "0.1.0",
  "publisher": "Vali-98",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vali-98/valdroid-emulator.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/Vali-98/valdroid-emulator",
  "bugs": {
    "url": "https://github.com/Vali-98/valdroid-emulator/issues"
  },
  "extensionKind": ["ui"],
  "keywords": ["android", "emulator", "adb", "logcat"],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:valdroidConsole.view",
    "onCommand:valdroid-emulator.console",
    "onView:valdroidEmulator.view",
    "onCommand:valdroid-emulator.start",
    "onCommand:valdroid-emulator.stop",
    "onCommand:valdroid-emulator.show"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "valdroid-emulator.show",
        "title": "Valdroid: Show Emulator"
      },
      {
        "command": "valdroid-emulator.start",
        "title": "Valdroid: Start Emulator"
      },
      {
        "command": "valdroid-emulator.stop",
        "title": "Valdroid: Stop Stream"
      },
      {
        "command": "valdroid-emulator.console",
        "title": "Valdroid: Show ADB Console",
        "icon": "$(terminal)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "valdroid-emulator.console",
          "when": "view == valdroidEmulator.view",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "valdroidConsole",
          "title": "Valdroid",
          "icon": "media/android.svg"
        },
        {
          "id": "valdroidEmulator",
          "title": "Android Emulator",
          "icon": "media/android.svg"
        }
      ]
    },
    "views": {
      "valdroidConsole": [
        {
          "id": "valdroidConsole.view",
          "name": "ADB Console",
          "type": "webview"
        }
      ],
      "valdroidEmulator": [
        {
          "id": "valdroidEmulator.view",
          "name": "Emulator",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Valdroid Emulator",
      "properties": {
        "valdroid-emulator.adbPath": {
          "type": "string",
          "default": "adb",
          "description": "Path to Android Debug Bridge."
        },
        "valdroid-emulator.emulatorPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to the Android emulator executable. Defaults to the executable under ANDROID_HOME/ANDROID_SDK_ROOT."
        },
        "valdroid-emulator.bitRate": {
          "type": "integer",
          "default": 10000000,
          "minimum": 100000,
          "maximum": 100000000,
          "description": "AVC video bitrate in bits per second."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "vsix": "node scripts/package-vsix.cjs",
    "test:packaging": "node --test scripts/*.test.cjs",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "npm run check-types && tsc --noEmit -p tests/tsconfig.json && vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/shell-quote": "^1.7.5",
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.19",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "file-selector": "^2.1.2",
    "lucide-react": "^1.57.0",
    "opus-decoder": "^0.7.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^14.3.8",
    "shell-quote": "^1.12.0"
  }
}
