{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "types": [
            "node"
        ],
        "sourceMap": true,
        "rootDir": "src",
        "strict": true, /* enable all strict type-checking options */
        "jsx": "react-jsx",
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": ["src/**/*"]
}
