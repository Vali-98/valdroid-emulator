{
  "name": "valdroid-emulator",
  "displayName": "Val's Android Emulator",
  "description": "Control Android emulators from a VS Code side panel, with room for additional device panels.",
  "version": "0.1.0",
  "publisher": "valdroid",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:valdroidEmulator.view",
    "onCommand:valdroid-emulator.start",
    "onCommand:valdroid-emulator.stop",
    "onCommand:valdroid-emulator.show"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "valdroid-emulator.show",
        "title": "Valdroid: Show Emulator"
      },
      {
        "command": "valdroid-emulator.start",
        "title": "Valdroid: Start Emulator"
      },
      {
        "command": "valdroid-emulator.stop",
        "title": "Valdroid: Stop Stream"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "valdroidEmulator",
          "title": "Android Emulator",
          "icon": "media/android.svg"
        }
      ]
    },
    "views": {
      "valdroidEmulator": [
        {
          "id": "valdroidEmulator.view",
          "name": "Emulator",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Valdroid Emulator",
      "properties": {
        "valdroid-emulator.adbPath": {
          "type": "string",
          "default": "adb",
          "description": "Path to Android Debug Bridge."
        },
        "valdroid-emulator.emulatorPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to the Android emulator executable. Defaults to the executable under ANDROID_HOME/ANDROID_SDK_ROOT."
        },
        "valdroid-emulator.bitRate": {
          "type": "integer",
          "default": 10000000,
          "minimum": 100000,
          "maximum": 100000000,
          "description": "AVC video bitrate in bits per second."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "npm run check-types"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
